---
// src/pages/hackathons/index.astro — hackathon submissions and bounty work,
// with team-mates credited where the work was not solo.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getList } from '../../lib/lists';

const entries = await getList('hackathons');
---

<BaseLayout title="Hackathons and Bounties">
  <h1>Hackathons and Bounties</h1>
  <ProjectList entries={entries} />
</BaseLayout>
