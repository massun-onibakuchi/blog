---
// src/pages/index.astro — home. Avatar, name and a short bio, nothing else
// (end-state §2). Every section is one click away via the header nav, so the
// home page itself carries no excerpts. There is no /about page: this is it.
import BaseLayout from '../layouts/BaseLayout.astro';
import WhoAmI from '../components/WhoAmI.astro';
import { SITE } from '../site';
---

<BaseLayout>
  <div class="profile">
    <img class="avatar" src="/avatar.jpg" alt="" width="96" height="96" />
    <div>
      <h1 class="name">{SITE.name}</h1>
      <WhoAmI />
      <p class="bio">{SITE.bio}</p>
    </div>
  </div>
</BaseLayout>
