---
// src/pages/index.astro — home. Avatar, name and a short bio, nothing else
// (end-state §2). Every section is one click away via the header nav, so the
// home page itself carries no excerpts. There is no /about page: this is it.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
---

<BaseLayout>
  <div class="profile">
    <img class="avatar" src="/avatar.jpg" alt="" width="72" height="72" />
    <div>
      <h1 class="name">{SITE.name}</h1>
      <p>
        {SITE.bio}{' '}
        Earlier writing is at{' '}
        <a href={SITE.previousBlog} rel="noopener" target="_blank">mirror.xyz</a>.
      </p>
    </div>
  </div>
</BaseLayout>
