---
// src/pages/index.astro — home. Short bio plus the latest few from every section,
// each linking out (end-state §2). There is no /about page: this is it.
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { getSection } from '../lib/articles';
import { getCollection } from 'astro:content';
import { SITE } from '../site';

const EXCERPT_COUNT = 5;
const publications = (await getSection('publications')).slice(0, EXCERPT_COUNT);
const posts = (await getSection('posts')).slice(0, EXCERPT_COUNT);
const openSource = (await getCollection('openSource')).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout>
  <p>{SITE.bio}</p>

  <h2><a href="/publications/">Publications</a></h2>
  <EntryList articles={publications} empty="No publications yet." />

  <h2><a href="/open-source/">Open Source</a></h2>
  <ul class="entries">
    {
      openSource.slice(0, EXCERPT_COUNT).map((project) => (
        <li>
          <a href={project.data.url} rel="noopener">
            {project.data.name}
          </a>{' '}
          <span class="meta">{project.data.year}</span>
        </li>
      ))
    }
  </ul>

  <h2><a href="/posts/">Posts</a></h2>
  <EntryList articles={posts} empty="No posts yet." />
</BaseLayout>
