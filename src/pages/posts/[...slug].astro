---
// src/pages/posts/[...slug].astro — one post. Same shape as a publication page;
// the sections differ in editorial standard, not in presentation.
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getSection, hasMath, localOnly, neighbours } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = localOnly(await getSection('posts'));
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, ...neighbours(articles, article.id) },
  }));
}

const { article, newer, older } = Astro.props;
const { Content } = await render(article);
---

<ArticleLayout article={article} newer={newer} older={older} math={hasMath(article.body)}>
  <Content />
</ArticleLayout>
