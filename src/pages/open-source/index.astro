---
// src/pages/open-source/index.astro — public work: contracts and tools, plus the
// security research (exploit reproductions, vulnerability collections) that also
// lives in the open. One list, in the author's order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getList } from '../../lib/lists';

const entries = await getList('openSource');
---

<BaseLayout title="Open Source">
  <h1>Open Source</h1>
  <ProjectList entries={entries} />
</BaseLayout>
