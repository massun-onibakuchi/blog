---
// src/components/EntryList.astro — the one way articles appear in a list.
// Title, date and tags only: no excerpt, no thumbnail, and deliberately no
// language badge (end-state §2 and §3 — the badge lives on the article page).
import { dateAttr, formatDate, href, isExternal, tagKey, type Article } from '../lib/articles';

interface Props {
  articles: Article[];
  empty?: string;
}

const { articles, empty = 'Nothing here yet.' } = Astro.props;
---

{articles.length === 0 && <p class="meta">{empty}</p>}

<ul class="entries">
  {
    articles.map((article) => (
      <li>
        <a
          href={href(article)}
          rel={isExternal(article) ? 'noopener' : undefined}
          target={isExternal(article) ? '_blank' : undefined}
        >
          {article.data.title}
          {/* Older writing lives on Qiita, Medium and HackMD; say so before the click. */}
          {isExternal(article) && <span class="meta"> ↗</span>}
        </a>
        {' '}
        {/* Externally hosted writing may carry no date; then nothing is shown. */}
        {article.data.date && (
          <time datetime={dateAttr(article.data.date, article.data.datePrecision)}>
            {formatDate(article.data.date, article.data.datePrecision)}
          </time>
        )}
        {article.data.tags.length > 0 && (
          <span class="tag-list">
            {article.data.tags.map((tag) => (
              <a class="meta" href={`/tags/${encodeURIComponent(tagKey(tag))}/`}>
                #{tag}
              </a>
            ))}
          </span>
        )}
      </li>
    ))
  }
</ul>
