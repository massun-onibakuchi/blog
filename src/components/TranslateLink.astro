---
// src/components/TranslateLink.astro — the language button (end-state §4).
// Opens ChatGPT with a prefilled prompt: an instruction plus this article's URL.
// The target language is always the opposite of what the article is written in,
// because every article exists in exactly one language.
//
// `url` is only a no-JS fallback. On click we rebuild the prompt from the
// browser's current URL so a localhost build origin can never leak into a
// translation link served from production.

interface Props {
  lang: 'en' | 'ja';
  url: string;
}

const { lang, url } = Astro.props;
const target = lang === 'en' ? { code: 'ja', name: 'Japanese', label: '日本語で読む' }
  : { code: 'en', name: 'English', label: 'Read in English' };

const instruction = `Read this article and translate it into ${target.name}. Keep the technical terms, code blocks and math unchanged.`;
const prompt = `${instruction}\n${url}`;
const href = `https://chatgpt.com/?prompt=${encodeURIComponent(prompt)}&hints=search`;
---

<a
  href={href}
  rel="noopener"
  target="_blank"
  hreflang={target.code}
  data-translate
  data-translate-instruction={instruction}
>
  {target.label}
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-translate]').forEach((link) => {
    link.addEventListener('click', () => {
      const instruction = link.dataset.translateInstruction;
      if (!instruction) return;

      const articleUrl = new URL(window.location.pathname, window.location.origin).href;
      const chatgptUrl = new URL('https://chatgpt.com/');
      chatgptUrl.searchParams.set('prompt', `${instruction}\n${articleUrl}`);
      chatgptUrl.searchParams.set('hints', 'search');
      link.href = chatgptUrl.href;
    });
  });
</script>
