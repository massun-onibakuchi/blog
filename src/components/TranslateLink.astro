---
// src/components/TranslateLink.astro — the language helper (end-state §4).
// Opens ChatGPT with the article URL already in a summary prompt. Summarizing a
// linked article avoids the full-translation copyright restriction and removes
// the old clipboard/paste step from the reader flow.
//
// The target language is always the opposite of what the article is written in,
// because every article exists in exactly one language.

interface Props {
  lang: 'en' | 'ja';
  url: string;
}

const { lang, url } = Astro.props;
const target = lang === 'en'
  ? { code: 'ja', name: 'Japanese', label: 'ChatGPTで日本語の要約を読む' }
  : { code: 'en', name: 'English', label: 'Summarize in English with ChatGPT' };

const prompt = `Summarize the article at ${url} in ${target.name}. Preserve the key technical details, experimental setup, results, numbers, caveats and conclusions.`;
const href = `https://chatgpt.com/?prompt=${encodeURIComponent(prompt)}`;
---

<a
  href={href}
  rel="noopener"
  target="_blank"
  hreflang={target.code}
  data-translate
>
  {target.label}
</a>
