---
// src/components/TranslateLink.astro — the language button (end-state §4).
// Opens ChatGPT with the full Markdown article body already included in the
// prefilled prompt, so the reader does not need to copy either text or a URL.
//
// The target language is always the opposite of what the article is written in,
// because every article exists in exactly one language.

interface Props {
  lang: 'en' | 'ja';
  body: string;
}

const { lang, body } = Astro.props;
const target = lang === 'en'
  ? { code: 'ja', name: 'Japanese', label: 'ChatGPTで日本語に翻訳' }
  : { code: 'en', name: 'English', label: 'Translate to English with ChatGPT' };

const instruction = `Translate the following article text into ${target.name}. Keep technical terms, Markdown formatting, links, code blocks and math unchanged.`;
const prompt = `${instruction}\n\n${body.trim()}`;
const href = `https://chatgpt.com/?prompt=${encodeURIComponent(prompt)}`;
---

<a
  href={href}
  rel="noopener"
  target="_blank"
  hreflang={target.code}
  data-translate
>
  {target.label}
</a>
