---
// src/components/Header.astro — wordmark, section links, and the top-right corner
// (GitHub + theme toggle). Social links render from SITE.links, so adding X later
// is one line in src/site.ts with no layout change.
import { SITE, SECTIONS } from '../site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/">{SITE.name}</a>
  <nav aria-label="Sections">
    {
      SECTIONS.map((section) => (
        <a href={`${section.href}/`} aria-current={path.startsWith(section.href) ? 'page' : undefined}>
          {section.label}
        </a>
      ))
    }
  </nav>
  <span class="spacer"></span>
  {
    SITE.links.x && (
      <a class="icon-link" href={SITE.links.x} rel="me noopener" aria-label="X">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.9 2h3.4l-7.4 8.5L23.6 22h-6.8l-5.3-7-6.1 7H2l7.9-9.1L1.7 2h7l4.8 6.4L18.9 2Zm-1.2 18h1.9L7.4 3.9H5.4L17.7 20Z" />
        </svg>
      </a>
    )
  }
  {
    SITE.links.github && (
      <a class="icon-link" href={SITE.links.github} rel="me noopener" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
    )
  }
  <ThemeToggle />
</header>
