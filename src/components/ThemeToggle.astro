---
// src/components/ThemeToggle.astro — dark/light switch with a circular reveal
// growing from the click point (end-state §5). Uses the View Transitions API and
// degrades to a plain swap where it is missing (Firefox) or unwanted (reduced motion).
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"
      data-theme-icon="dark"></path>
    <path
      d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-6v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"
      stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"
      data-theme-icon="light"></path>
  </svg>
</button>

<style>
  /* One icon at a time: the sun means "you are in dark mode, click for light".
     `:global` on the ancestor is load-bearing — `data-theme` sits on <html>, which
     carries no scope attribute, so a scoped selector there matches nothing and both
     icons draw on top of each other. */
  :global([data-theme='light']) [data-theme-icon='light'],
  :global([data-theme='dark']) [data-theme-icon='dark'] {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('[data-theme-toggle]');
    if (!button) return;

    const apply = (theme) => {
      root.dataset.theme = theme;
      localStorage.setItem('theme', theme);
    };

    button.addEventListener('click', (event) => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !document.startViewTransition) {
        apply(next);
        return;
      }

      // Grow the circle from the button itself, so the new theme visibly
      // originates where the reader clicked.
      const rect = event.currentTarget.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

      const transition = document.startViewTransition(() => apply(next));
      transition.ready.then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 400, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
        );
      });
    });
  })();
</script>
